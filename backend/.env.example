# Settings load (in order, later overrides): backend/.env then repo-root ../.env when you run uvicorn from backend/.
APP_NAME=AI Drug Discovery Platform API
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=false
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/drug_platform
REDIS_URL=redis://localhost:6379/0
DOCKING_SERVICE_URL=http://localhost:8090
GENERATOR_SERVICE_URL=http://localhost:8091
# Default is real computation; never silently substitute synthetic examples.
UNIVERSAL_DISCOVERY_MODE=production
# Explicit per-request engine_mode=demo remains available for NON-SCIENTIFIC demos.
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SIGNING_KEY=
ADMIN_PASSWORD=
# Without a signing key, interactive user authentication is disabled.
#
# AI Pharma UI / dis istemciler: farmakofor olmadan kesif
#   POST http://127.0.0.1:8000/api/motor/discover
#   (govde = yeni_motor POST /api/discover ile ayni JSON)
